# Verify commands (sourced by scripts/verify.sh). Written by `kit.py config`; edit by hand if needed.
# PROTECTED: agents may not change this file; commit changes with GUARD_ADMIN=1.
# Tests must print their names (verbose reporter) so acceptance-criterion IDs (AC-xxx-yy) appear in the log.
# Empty / unset = auto-detect. SKIP = deliberately off (reported as SKIP, never as PASS).
KIT_STACK="auto"   # let verify.sh auto-detect Node, Python, Go or Rust from the manifest files
KIT_MODE="fast"     # fast: slow steps in CI only, review optional | strict: all steps locally, security-sensitive features need an independent review

# VERIFY_TYPECHECK=
# VERIFY_LINT=
# VERIFY_TEST=
# VERIFY_TEST_QUICK=
# VERIFY_BUILD=
# VERIFY_E2E=
# VERIFY_AUDIT=
# VERIFY_PERF=
# VERIFY_MUTATION=
# VERIFY_PERF: e.g. npx size-limit | k6 run perf/smoke.js | pytest -m perf   (performance budget)
# VERIFY_MUTATION: e.g. npx stryker run | mutmut run   (proves tests catch bugs; slow: strict + CI)

# Steps listed here run only when CI is set (GitHub Actions sets CI=true); the local gate stays fast.
VERIFY_CI_ONLY="build e2e audit scanners perf mutation"

# Held-out acceptance tests (strict: only an evaluator session may change them) and duplicate-code window
ACCEPTANCE_GLOB="tests/acceptance/*"
DUPES_MIN_LINES="8"

VERIFY_TAIL=25
VERIFY_TEST="python3 -m unittest discover -s tests"
